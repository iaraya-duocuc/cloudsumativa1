{
  "info": {
    "name": "cloudsumativa1 - Pruebas iniciales",
    "description": "Iniciar la API y ejecutar la colección en orden. Los IDs se guardan automáticamente. Cada ejecución crea un usuario y un evento nuevos. Cambiar baseUrl si corresponde.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ignacio\",\n  \"correo\": \"{{correoPrueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.test(\"ID generado\", function () { pm.expect(data.id).to.be.a(\"number\"); }); pm.collectionVariables.set(\"usuarioId\", data.id); }"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"correoPrueba\", \"prueba.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Crear evento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/eventos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "eventos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Concierto de prueba\",\n  \"fecha\": \"2027-01-10T20:00:00\",\n  \"precio\": 15000,\n  \"cuposDisponibles\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.test(\"ID generado\", function () { pm.expect(data.id).to.be.a(\"number\"); }); pm.collectionVariables.set(\"eventoId\", data.id); }"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 - Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista de usuarios\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 - Consultar usuario creado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "{{usuarioId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"ID solicitado\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"usuarioId\"))); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 - Listar eventos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "eventos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista de eventos\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 - Consultar evento creado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/eventos/{{eventoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "eventos",
            "{{eventoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"ID solicitado\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"eventoId\"))); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 - Reservar y generar ticket TXT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/eventos/{{eventoId}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "eventos",
            "{{eventoId}}",
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": {{usuarioId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"ticketId\", pm.response.json().id); }"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 - Consultar ticket",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "09 - Descargar ticket TXT",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}/archivo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}",
            "archivo"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Archivo TXT\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"); pm.expect(pm.response.text()).to.include(\"TICKET DE RESERVA\"); });"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
