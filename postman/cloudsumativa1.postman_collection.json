                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Descargar ticket TXT desde S3",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/s3",
              "host": [
                "{{baseUrl}}"
              ],
